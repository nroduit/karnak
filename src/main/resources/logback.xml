<?xml version="1.0" encoding="UTF-8"?>
<!--
  Default logging configuration. The appenders are selected by the active Spring profile:
    - portable: console + rolling file logs/karnak.log (size-based rotation, see KARNAK_LOGS_*)
    - any other deployment (docker, jar, IDE): console only; the log driver of the host collects it
  A custom configuration can replace this file with -Dlogging.config=<file>
  (LOGBACK_CONFIGURATION_FILE in the docker image).

  De-identification and tag-morphing operations emit DEBUG events carrying the CLINICAL marker
  and the following MDC values, which a custom configuration can route to a dedicated file with
  an OnMarkerEvaluator filter:
    issuerOfPatientID, PatientID, SOPInstanceUID, SeriesInstanceUID (before the profile),
    DeidentifySOPInstanceUID, DeidentifySeriesInstanceUID (after de-identification),
    TagMorphingSOPInstanceUID, TagMorphingSeriesInstanceUID (after tag morphing),
    ProjectName, ProfileName, ProfileCodenames
-->
<configuration>
    <property name="LOGS" value="logs" />

    <springProfile name="portable">
        <appender name="PORTABLE_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%black(%d{ISO8601})  %highlight(%-5level) %marker %highlight(%X{SOPInstanceUID}) %highlight(%X{issuerOfPatientID}) %highlight(%X{PatientID}) [%yellow(%t)] %yellow(%C{1}): %msg%n%throwable </pattern>
            </encoder>
        </appender>

        <appender name="PORTABLE_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOGS}/karnak.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
                <fileNamePattern>${LOGS}/karnak%i.log</fileNamePattern>
                <minIndex>${KARNAK_LOGS_MIN_INDEX:-1}</minIndex>
                <maxIndex>${KARNAK_LOGS_MAX_INDEX:-10}</maxIndex>
            </rollingPolicy>
            <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
                <maxFileSize>${KARNAK_LOGS_MAX_FILE_SIZE:-50MB}</maxFileSize>
            </triggeringPolicy>
            <encoder>
                <pattern>%black(%d{ISO8601})  %highlight(%-5level) %marker %highlight(%X{SOPInstanceUID}) %highlight(%X{issuerOfPatientID}) %highlight(%X{PatientID}) [%yellow(%t)] %yellow(%C{1}): %msg%n%throwable </pattern>
            </encoder>
        </appender>

        <logger name="org.karnak" level="info" additivity="false">
            <appender-ref ref="PORTABLE_CONSOLE"/>
            <appender-ref ref="PORTABLE_FILE"/>
        </logger>
    </springProfile>

    <springProfile name="!portable">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="STDOUT" />
        </root>
    </springProfile>
</configuration>
