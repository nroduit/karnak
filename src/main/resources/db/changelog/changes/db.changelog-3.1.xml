  <!-- B-tree indexes on foreign-key columns that had none, so profile lookups by
       profile_element_id / profile_id stop doing sequential scans during forwarding.
       transfer_status was dropped in 1.9-13; transfer_series_status.destination_id,
       transfer_series_instance.series_status_id and transfer_series_reason.series_status_id
       are already covered by existing indexes or unique constraints (leading column).

       PostgreSQL: CREATE INDEX CONCURRENTLY runs outside a transaction. If it is interrupted
       it leaves an INVALID index behind, which both the indexExists precondition and
       IF NOT EXISTS then skip. Repair with: REINDEX INDEX CONCURRENTLY <index name>; -->

  <changeSet author="karnak" id="3.1-1-h2" dbms="h2">
    <preConditions onFail="MARK_RAN">
      <not>
        <indexExists indexName="idx_tag_profile_element_id"/>
      </not>
    </preConditions>
    <createIndex indexName="idx_tag_profile_element_id" tableName="tag">
      <column name="profile_element_id"/>
    </createIndex>
  </changeSet>
  <changeSet author="karnak" id="3.1-1-postgresql" dbms="postgresql" runInTransaction="false">
    <preConditions onFail="MARK_RAN">
      <not>
        <indexExists indexName="idx_tag_profile_element_id"/>
      </not>
    </preConditions>
    <sql>CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_tag_profile_element_id ON tag (profile_element_id);</sql>
  </changeSet>

