							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "monitoring", "studies" ],
							"query": [
								{ "key": "destinationUuid", "value": "{{destinationUuid}}" },
								{ "key": "statusType", "value": "ALL", "disabled": true }
							]
						}
					}
				},
