{
	"info": {
		"name": "Karnak API - ForwardNode, Profile, Project, Monitoring, Pseudonym, Echo",
		"description": "Collection covering the REST endpoints of the ForwardNodeController, ProfileController, ProjectController, MonitoringController, PseudonymController and EchoController controllers of Karnak.\n\nAuthentication: Basic Auth (variables {{karnakUser}} / {{karnakPassword}}), default values admin/karnak (see application.yml / KARNAK_ADMIN / KARNAK_PASSWORD).\n\nDefault base URL: http://localhost:8081 (server.port in application.yml).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "basic",
		"basic": [
			{ "key": "username", "value": "{{karnakUser}}", "type": "string" },
			{ "key": "password", "value": "{{karnakPassword}}", "type": "string" }
		]
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8081" },
		{ "key": "karnakUser", "value": "admin" },
		{ "key": "karnakPassword", "value": "karnak" },
		{ "key": "forwardNodeUuid", "value": "" },
		{ "key": "sourceNodeUuid", "value": "" },
		{ "key": "destinationUuid", "value": "" },
		{ "key": "profileUuid", "value": "" },
		{ "key": "elementUuid", "value": "" },
		{ "key": "projectUuid", "value": "" },
		{ "key": "studyUid", "value": "" },
		{ "key": "serieUid", "value": "" },
		{ "key": "pseudonym", "value": "" },
		{ "key": "projectUUID", "value": "" },
		{ "key": "secretUuid", "value": "" },
		{ "key": "srcAet", "value": "" }
	],
	"item": [
		{
			"name": "ForwardNode",
			"item": [
				{
					"name": "List all forward nodes",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json;version=1" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/forward-nodes",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "forward-nodes" ]
						}
					}
				},
				{
					"name": "Create a forward node",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json;version=1" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fwdAeTitle\": \"KARNAK_FWD\",\n  \"fwdDescription\": \"Forward node created\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/forward-nodes",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "forward-nodes" ]
						}
					}
				},
				{
					"name": "Get a forward node by uuid",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json;version=1" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/forward-nodes/{{forwardNodeUuid}}",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "forward-nodes", "{{forwardNodeUuid}}" ]
						}
					}
				},
				{
					"name": "Update a forward node",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json;version=1" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fwdAeTitle\": \"FWD_UPDATED\",\n  \"fwdDescription\": \"Updated description\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/forward-nodes/{{forwardNodeUuid}}",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "forward-nodes", "{{forwardNodeUuid}}" ]
						}
					}
				},
				{
					"name": "Delete a forward node",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Accept", "value": "application/json;version=1" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/forward-nodes/{{forwardNodeUuid}}",
							"host": [ "{{baseUrl}}" ],
