					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json;version=1" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"description\": \"Destination created\",\n  \"destinationType\": \"dicom\",\n  \"activate\": true,\n  \"desidentification\": true,\n  \"aeTitle\": \"DEST_AET\",\n  \"hostname\": \"127.0.0.1\",\n  \"port\": 11112\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/forward-nodes/{{forwardNodeUuid}}/destinations",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "forward-nodes", "{{forwardNodeUuid}}", "destinations" ]
						}
					}
				},
				{
					"name": "Update a destination of a forward node",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json;version=1" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"description\": \"Destination updated\",\n  \"destinationType\": \"dicom\",\n  \"activate\": true,\n  \"desidentification\": true,\n  \"aeTitle\": \"DEST_AET\",\n  \"hostname\": \"127.0.0.1\",\n  \"port\": 11113\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/forward-nodes/{{forwardNodeUuid}}/destinations/{{destinationUuid}}",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "forward-nodes", "{{forwardNodeUuid}}", "destinations", "{{destinationUuid}}" ]
						}
					}
				},
				{
					"name": "Delete a destination from a forward node",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Accept", "value": "application/json;version=1" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/forward-nodes/{{forwardNodeUuid}}/destinations/{{destinationUuid}}",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "forward-nodes", "{{forwardNodeUuid}}", "destinations", "{{destinationUuid}}" ]
						}
					}
				}
			]
		},
