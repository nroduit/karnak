					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Accept", "value": "application/json;version=1" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/forward-nodes/{{forwardNodeUuid}}/source-nodes/{{sourceNodeUuid}}",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "forward-nodes", "{{forwardNodeUuid}}", "source-nodes", "{{sourceNodeUuid}}" ]
						}
					}
				},
				{
					"name": "List destinations of a forward node",
