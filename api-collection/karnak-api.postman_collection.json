		{
			"name": "Monitoring",
			"item": [
				{
					"name": "List all destinations with aggregated transfer activity",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/monitoring/destinations?statusType=ALL",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "monitoring", "destinations" ],
							"query": [
								{ "key": "statusType", "value": "ALL" },
								{ "key": "start", "value": "", "disabled": true },
								{ "key": "end", "value": "", "disabled": true }
							]
						}
					}
				},
				{
					"name": "List studies under a destination",
