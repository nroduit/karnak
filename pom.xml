  <build>
    <defaultGoal>spring-boot:run</defaultGoal>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>3.0.0</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>am.ik.maven</groupId>
        <artifactId>nullability-maven-plugin</artifactId>
        <configuration>
          <skip>${nullability.skip}</skip>
          <checking>main</checking>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- Reused/persisted CI workspaces (e.g. Jenkins agents that don't run
               `mvn clean`) can trip the source/.class staleness check after a fresh
               git checkout resets file timestamps: a newly added test class then
               looks "already compiled" even though target/test-classes has no
               matching .class, and surefire fails with ClassNotFoundException while
               scanning the classpath. Disabling incremental compilation forces a
               full recompile every run and avoids that class of failure. -->
          <useIncrementalCompilation>false</useIncrementalCompilation>
<!--          <release>${java.version}</release>-->
<!--          <parameters>true</parameters>-->
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <image>
            <runImage>${docker-registry}/vna-docker-base-image:5.0.0</runImage>
          </image>
        </configuration>
      </plugin>

      <!-- Take care of synchronizing java dependencies and imports in package.json and main.js files. It also creates webpack.config.js
        if not exists yet. -->
      <plugin>
        <groupId>com.vaadin</groupId>
        <artifactId>vaadin-maven-plugin</artifactId>
        <version>${vaadin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>prepare-frontend</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.9.0</version>
        <configuration>
          <!-- define a language-specific format -->
          <java>
            <!-- Organize imports: drop unused, sort alphabetically, never use '*'.
                 Group order matches spring-javaformat: static imports first, a blank
                 line, then all other imports (so the two plugins do not conflict). -->
            <removeUnusedImports />
            <importOrder>
              <order>\#,</order>
            </importOrder>
            <licenseHeader>
              <!-- @formatter:off -->
              <content>
/*
 * Copyright (c) $YEAR Karnak Team and other contributors.
 *
 * This program and the accompanying materials are made available under the terms of the Eclipse
 * Public License 2.0 which is available at https://www.eclipse.org/legal/epl-2.0, or the Apache
 * License, Version 2.0 which is available at https://www.apache.org/licenses/LICENSE-2.0.
 *
 * SPDX-License-Identifier: EPL-2.0 OR Apache-2.0
 */
              </content>
              <!-- @formatter:on -->
            </licenseHeader>
          </java>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{argLine} -XX:+EnableDynamicAgentLoading -Xshare:off</argLine>
          <parallel>all</parallel>
          <groups>${karnak.test.groups}</groups>
          <excludedGroups>${karnak.test.excludedGroups}</excludedGroups>
        </configuration>
      </plugin>

      <!-- Disable the checkstyle-validation execution inherited from the parent POM. Rebinding the
           inherited execution to phase "none" disables it without removing the
           plugin declaration itself. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <executions>
          <execution>
            <id>checkstyle-validation</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>

